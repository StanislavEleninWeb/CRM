# Site file for crm.seweb.co, installed into the server's shared proxy
# (https://github.com/StanislavEleninWeb/caddy) by the deployment:  edge-site install crm <this file>
#
# The name is proxied by Cloudflare, so:
#   - the certificate is a Cloudflare Origin Certificate placed by hand in /etc/edge/certs/crm/
#     (Caddy cannot obtain a public one for a proxied name), and Cloudflare's SSL mode is "Full (strict)";
#   - only Cloudflare may connect: it presents a client certificate (Authenticated Origin Pulls),
#     and a request that reaches the server's address directly is refused during the TLS handshake.
#
# crm-api and crm-frontend are this application's containers on the shared "edge" network.
crm.seweb.co {
	tls /etc/caddy/certs/crm/origin.pem /etc/caddy/certs/crm/origin.key {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/certs/crm/cloudflare-origin-pull-ca.pem
		}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Monitoring figures are not served to the internet.
	@ops path /ops/*
	respond @ops 404

	@api path /api/* /healthz /readyz
	handle @api {
		request_body {
			max_size 25MB
		}
		reverse_proxy crm-api:8000 {
			# The visitor's address as Cloudflare saw it; the connecting address is always Cloudflare's.
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	handle {
		reverse_proxy crm-frontend:8080
	}
}
