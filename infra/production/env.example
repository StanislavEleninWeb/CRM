# Names of every setting a hosted environment needs. Values are placeholders: this file is
# an inventory, not a configuration. Keep the real file outside the repository
# (default path: /etc/seweb-crm/env, mode 0600) or inject from a secret manager.

ENVIRONMENT=production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://crm.seweb.co

# PostgreSQL. The application connects as crm_app, a role that cannot change the schema or
# bypass row-level security. The schema owner's connection string is NOT in this file: it is in
# migrate.env, which only the one-off migration job reads.
DATABASE_URL=postgresql+psycopg://crm_app:change-me-app-password@db:5432/crm
REDIS_URL=redis://redis:6379/0

SESSION_SECRET=change-me-at-least-32-characters-long
SECRET_ENCRYPTION_KEYS=v1:change-me-base64-32-bytes
ERASURE_HASH_KEY=change-me-set-once-back-it-up-never-rotate
OPS_METRICS_TOKEN=change-me-monitoring-token

# Sign-in: AWS Cognito. The issuer is https://cognito-idp.<region>.amazonaws.com/<user pool id>.
OIDC_ISSUER=https://cognito-idp.eu-central-1.amazonaws.com/change-me-pool-id
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
OIDC_SCOPES=openid email profile
OIDC_DEV_PROVIDER=false

# Files: AWS S3. No endpoint is set for AWS itself. The key may only read, write and delete
# objects in this one bucket.
S3_ENDPOINT_URL=
S3_REGION=eu-central-1
S3_BUCKET=change-me-files-bucket
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Off until their gates pass. See docs/release-gates.md.
EMAIL_DISPATCH=off
BILLING_MODE=off
EXTERNAL_GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_INTERNAL_DOMAIN=
GMAIL_INTERNAL_TENANT_IDS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
