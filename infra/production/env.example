# Names of every setting a hosted environment needs. Values are placeholders: this file is
# an inventory, not a configuration. Keep the real file outside the repository
# (default path: /etc/seweb-crm/env, mode 0600) or inject from a secret manager.

ENVIRONMENT=staging
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://crm.example.com

# PostgreSQL. The application connects as crm_app; only the migration job uses crm_migrator.
DATABASE_URL=postgresql+psycopg://crm_app:change-me-app-password@db:5432/crm
MIGRATION_DATABASE_URL=postgresql+psycopg://crm_migrator:change-me-migrator-password@db:5432/crm
REDIS_URL=redis://redis:6379/0

SESSION_SECRET=change-me-at-least-32-characters-long
SECRET_ENCRYPTION_KEYS=v1:change-me-base64-32-bytes
ERASURE_HASH_KEY=change-me-set-once-and-back-up
OPS_METRICS_TOKEN=change-me-monitoring-token

# Identity provider (U-01). The development provider is refused here.
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me
OIDC_DEV_PROVIDER=false

# Object storage (S3-compatible).
S3_ENDPOINT_URL=https://s3.example.com
S3_REGION=eu-central-1
S3_BUCKET=seweb-crm
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Off until their gates pass. See docs/release-gates.md.
EMAIL_DISPATCH=off
BILLING_MODE=off
EXTERNAL_GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_INTERNAL_DOMAIN=
GMAIL_INTERNAL_TENANT_IDS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
