# TLS is obtained and renewed automatically for PUBLIC_HOST. HTTP is redirected to HTTPS.
{
	email {$ACME_EMAIL}
}

{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# The monitoring endpoint is not served to the internet; scrape it from inside the host.
	@ops path /ops/*
	respond @ops 404

	@api path /api/* /healthz /readyz
	handle @api {
		request_body {
			max_size 25MB
		}
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:8080
	}
}
