# Placeholders only. Copy to .env for local development. Never commit real values.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL — three roles: owner (bootstrap only), migrator (DDL), app (runtime, no BYPASSRLS)
POSTGRES_DB=crm
POSTGRES_USER=crm_owner
POSTGRES_PASSWORD=change-me-owner
MIGRATOR_PASSWORD=change-me-migrator
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql+psycopg://crm_app:change-me-app@db:5432/crm
MIGRATION_DATABASE_URL=postgresql+psycopg://crm_migrator:change-me-migrator@db:5432/crm

REDIS_URL=redis://redis:6379/0

# Sessions and CSRF
SESSION_SECRET=change-me-at-least-32-characters-long
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# OIDC. OIDC_ISSUER is the exact "iss" value and the address the browser uses.
# OIDC_INTERNAL_URL is how the API reaches the same provider from inside the network.
# The bundled provider (Dex, static users, password "dev-password") is for development only.
OIDC_ISSUER=http://localhost:5556/dex
OIDC_INTERNAL_URL=http://oidc:5556/dex
OIDC_CLIENT_ID=crm-local
OIDC_CLIENT_SECRET=change-me-oidc
OIDC_DEV_PROVIDER=true

# Object storage (S3-compatible)
S3_ENDPOINT_URL=http://storage:9000
S3_BUCKET=crm-local
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret

# Provider-secret encryption: comma-separated "version:base64key" pairs, newest first.
# Each key is 32 random bytes, base64-encoded:  openssl rand -base64 32
# `make up` generates a local key when this is empty.
SECRET_ENCRYPTION_KEYS=

# Tenant defaults
DEFAULT_CURRENCY=EUR
DEFAULT_TIMEZONE=Europe/Sofia

# Gmail, internal pilot only (see docs/provider-setup.md). Leave empty to keep Gmail switched off.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_INTERNAL_DOMAIN=
GMAIL_INTERNAL_TENANT_IDS=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=
MAILBOX_RECONCILE_MINUTES=15
EXTERNAL_GMAIL_ENABLED=false
